{% from 'templates/_partials/json.jinja' import prettier_json %}
{% set recommendations = ['tboox.xmake-vscode', 'EditorConfig.EditorConfig'] %}
{% if not tooling_only %}
{% set _ = recommendations.append('gabriel-andreescu.bbcode-editor') %}
{% endif %}
{% if devbench_tests %}
{% set _ = recommendations.extend(['ms-python.python', 'charliermarsh.ruff']) %}
{% endif %}
{% if 'native' in components %}
{% set _ = recommendations.append('llvm-vs-code-extensions.vscode-clangd') %}
{% endif %}
{% if 'plugin_generation' in components or 'plugin_patching' in components or mcm %}
{% set _ = recommendations.extend(['ms-dotnettools.csharp', 'csharpier.csharpier-vscode']) %}
{% endif %}
{% if 'interface' in components %}
{% set _ = recommendations.append('redhat.vscode-xml') %}
{% endif %}
{{ prettier_json({'recommendations': recommendations}) }}
