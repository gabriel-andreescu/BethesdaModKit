<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mutagen.Bethesda.Synthesis" Version="0.36.6" />
    <PackageReference Include="Mutagen.Bethesda.{{ 'Skyrim' if game == 'skyrim' else 'Fallout4' }}" Version="0.54.4" />
  </ItemGroup>
  <!-- Synthesis 0.36.6 exports its own AssemblyVersions type. Its transitive generator duplicates it. -->
  <Target Name="ExcludeSynthesisGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer
        Remove="@(Analyzer)"
        Condition="'%(Analyzer.NuGetPackageId)' == 'Noggog.SourceGenerators'"
      />
    </ItemGroup>
  </Target>
</Project>
