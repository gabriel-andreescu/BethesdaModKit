#include "Settings.h"

#include <{{ 'SKSE/SKSE.h' if game == 'skyrim' else 'F4SE/F4SE.h' }}>

#include <CLIBUtil/simpleINI.hpp>
#include <spdlog/spdlog.h>

#include <filesystem>
#include <format>
#include <stdexcept>

namespace Settings {
namespace {
    Values current; // NOLINT(cppcoreguidelines-avoid-non-const-global-variables)

    void LoadFile(CSimpleIniA& ini, const std::filesystem::path& path) {
        ini.SetUnicode();
        if (std::filesystem::exists(path) && ini.LoadFile(path.c_str()) < 0) {
            throw std::runtime_error(std::format("Cannot read {}", path.string()));
        }
    }

    void ReadValues(CSimpleIniA& ini, Values& values) {
        clib_util::ini::get_value(
            ini,
            values.debugLogging,
            "General",
            "bDebugLogging",
            nullptr,
            clib_util::ini::bool_format::kNumeric
        );
    }
}

const Values& Get() {
    return current;
}

void Reload() {
    try {
        const std::filesystem::path defaultPath = L"Data/MCM/Config/{{ project_name }}/settings.ini";
        const std::filesystem::path userPath = L"Data/MCM/Settings/{{ project_name }}.ini";
        CSimpleIniA defaults;
        CSimpleIniA user;
        LoadFile(defaults, defaultPath);
        LoadFile(user, userPath);

        Values candidate;
        ReadValues(defaults, candidate);
        ReadValues(user, candidate);
        std::filesystem::create_directories(userPath.parent_path());
        if (user.SaveFile(userPath.c_str()) < 0) {
            throw std::runtime_error(std::format("Cannot save {}", userPath.string()));
        }
        current = candidate;
        spdlog::set_level(current.debugLogging ? spdlog::level::debug : spdlog::level::info);
    } catch (const std::exception& error) {
        {{ 'SKSE::log::warn' if game == 'skyrim' else 'REX::WARN' }}("Cannot load settings: {}", error.what());
    }
}
}
