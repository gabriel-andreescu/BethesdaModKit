target("Papyrus", function()
    set_default(false)
    add_rules("@addon/bmk/{{ game }}.papyrus", {
        root = "{{ papyrus_source }}",
        imports = (get_config("papyrus_imports") or ""):split(";", { plain = true }),
        flags = get_config("papyrus_flags"),
        arguments = { "--strict", "--enable-language-extensions=true" },
    })
    add_packages("caprica")
    add_files("$(projectdir)/{{ papyrus_source }}/**.psc{% if mcm %}|mcm/**{% endif %}")
    add_installfiles("$(projectdir)/{{ papyrus_source }}/(**.psc){% if mcm %}|mcm/**{% endif %}", { prefixdir = "{{ 'Source/Scripts' if game == 'skyrim' else 'Scripts/Source/User' }}" })
end)
